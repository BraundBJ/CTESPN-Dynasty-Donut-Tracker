<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#151219">
  <title>CTESPN Dynasty Donut Tracker</title>
  <script>
    try {
      if (sessionStorage.getItem("ctespn-access") === "granted") {
        document.documentElement.classList.add("access-granted");
      }
    } catch (error) {}
  </script>
  <style>
    :root {
      color-scheme: dark;
      --canvas: #151219;
      --surface: #201b26;
      --surface-raised: #2b2333;
      --line: #46394d;
      --ink: #fbf3fa;
      --muted: #c4b2c8;
      --accent: #ffadbc;
      --danger: #ff647c;
      background: var(--canvas);
      color: var(--ink);
      font: 16px/1.5 system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    body, h1, h2, p { margin: 0; }
    html:not(.access-granted) header, html:not(.access-granted) main { display: none; }
    html.access-granted .access-gate { display: none; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: .25rem; }
    .access-gate {
      min-height: 100svh;
      display: grid;
      place-items: center;
      padding: 1.5rem;
      background:
        radial-gradient(circle at 50% 18%, #643b4666 0 8%, transparent 30%),
        radial-gradient(circle at 50% 110%, #482635 0, transparent 48%),
        var(--canvas);
    }
    .access-card { width: min(100%, 28rem); padding: clamp(1.25rem, 5vw, 2rem); border: 1px solid var(--line); border-radius: 1rem; background: #201b26e8; box-shadow: 0 1.5rem 4rem #09070bb3; text-align: center; }
    .access-donut { width: 5.25rem; height: auto; margin-bottom: .75rem; transform: rotate(-12deg); filter: drop-shadow(0 .7rem 1rem #080609a6); }
    .access-brand { color: var(--accent); font: 800 .78rem ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; }
    .access-card h1 { margin: .45rem 0 0; font-size: clamp(1.55rem, 6.5vw, 2.35rem); line-height: 1.12; letter-spacing: -.035em; }
    .access-card form { display: grid; grid-template-columns: 1fr auto; gap: .5rem; margin-top: 1.35rem; }
    .access-card input, .access-card button { min-height: 3rem; border: 1px solid var(--line); border-radius: .55rem; color: var(--ink); font: inherit; }
    .access-card input { min-width: 0; padding: .65rem .75rem; background: var(--surface-raised); }
    .password-field { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .4rem; min-width: 0; }
    .access-card button { padding: .65rem 1rem; font-weight: 800; cursor: pointer; }
    .access-submit { background: var(--accent); color: var(--canvas) !important; }
    .show-password { background: var(--surface-raised); }
    .access-error { min-height: 1.5rem; margin-top: .6rem; color: var(--danger); font-weight: 700; }
    .wrap { width: min(86rem, calc(100% - 3rem)); margin-inline: auto; }
    header { background: var(--surface); border-bottom: 1px solid var(--line); }
    .brand { padding: 1rem 0; border-bottom: 1px solid var(--line); color: var(--accent); font-weight: 750; }
    .hero { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 2.5rem 0 2.75rem; }
    .kicker { color: var(--accent); font: 700 .78rem/1.4 ui-monospace, monospace; letter-spacing: .085em; text-transform: uppercase; }
    h1 { font-size: clamp(2.55rem, 7vw, 5rem); line-height: 1; letter-spacing: -.065em; margin: .45rem 0 .75rem; }
    .donut { flex: 0 0 auto; width: clamp(4.5rem, 17vw, 9rem); height: auto; margin-right: .75rem; transform: rotate(-12deg); }
    main { padding: 1.5rem 0 3rem; }
    .metrics { display: flex; flex-wrap: wrap; gap: .65rem; margin-bottom: 1.5rem; }
    .metrics > div { display: flex; align-items: baseline; gap: .6rem; padding: .5rem .85rem; border: 1px solid var(--line); border-radius: .65rem; background: var(--surface); }
    .metrics strong { font-size: 1.35rem; color: var(--accent); font-variant-numeric: tabular-nums; }
    .metrics span { color: var(--muted); font-size: .88rem; }
    h2 { font-size: 1.55rem; letter-spacing: -.03em; }
    [hidden] { display: none !important; }
    .podium {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      margin-bottom: 1.75rem;
      padding: 1rem clamp(.55rem, 3vw, 2rem) 1.7rem;
      border: 1px solid var(--line);
      border-radius: .9rem;
      background:
        radial-gradient(ellipse at 50% 35%, #8c573550 0 12%, transparent 42%),
        linear-gradient(115deg, transparent 0 27%, #f4bd5712 27% 28%, transparent 28% 72%, #f4bd5712 72% 73%, transparent 73%),
        linear-gradient(#271d2e, #17131c);
      box-shadow: inset 0 1px #ffffff14, 0 .7rem 1.8rem #0a080c80;
    }
    .podium::before {
      content: "";
      position: absolute;
      z-index: -1;
      inset: -35% 15% 38%;
      background: conic-gradient(from 165deg at 50% 0%, transparent 0 34%, #f9cb6945 40%, transparent 46% 54%, #f9cb6945 60%, transparent 66%);
      filter: blur(.25rem);
    }
    .podium::after {
      content: "";
      position: absolute;
      z-index: -1;
      left: 8%; right: 8%; bottom: .65rem;
      height: 1.2rem;
      border-radius: 50%;
      background: #09070bbb;
      filter: blur(.45rem);
    }
    .podium h2 { color: var(--accent); font: 750 .8rem ui-monospace, monospace; letter-spacing: .15em; text-transform: uppercase; }
    .podium-steps {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: end;
      gap: clamp(.25rem, 1vw, .7rem);
      width: min(100%, 36rem);
      margin: 0 auto;
      padding: 1rem 0 .35rem;
      border-bottom: 3px solid #705141;
    }
    .podium-place { position: relative; grid-row: 1; min-width: 0; text-align: center; }
    .place-1 { grid-column: 2; --medal: #ffdf9b; --metal-top: #694923; --metal-base: #2b1d18; --medal-edge: #a77537; --step-height: 5.55rem; }
    .place-2 { grid-column: 1; --medal: #e8e2ff; --metal-top: #4c4561; --metal-base: #272235; --medal-edge: #746989; --step-height: 4.65rem; }
    .place-3 { grid-column: 3; --medal: #ffceb8; --metal-top: #604039; --metal-base: #302027; --medal-edge: #8e6257; --step-height: 3.95rem; }
    .podium-name, .podium-tie { margin: 0 auto .55rem; font-size: clamp(.76rem, 2.3vw, .95rem); font-weight: 800; overflow-wrap: anywhere; }
    .place-1 .podium-name { width: fit-content; padding: .22rem .55rem; border: 1px solid #c38b3e; border-radius: 999px; background: #372518; color: var(--medal); box-shadow: 0 0 1rem #f5b74d3d; }
    .podium-tie summary { min-height: 2rem; padding: .4rem .1rem; cursor: pointer; }
    .podium-tie ul { padding: 0; margin: .25rem 0 .55rem; list-style: none; font-weight: 400; }
    .podium-tie li + li { margin-top: .3rem; }
    .podium-step {
      position: relative;
      overflow: hidden;
      display: grid;
      align-content: center;
      gap: .12rem;
      min-height: var(--step-height);
      padding: .35rem .2rem;
      border: 1px solid var(--medal-edge);
      border-radius: .52rem .52rem .15rem .15rem;
      background:
        linear-gradient(105deg, transparent 58%, #ffffff09 58%, #ffffff09 71%, transparent 71%),
        linear-gradient(var(--metal-top), var(--metal-base));
      box-shadow: inset 0 3px #ffffff18, inset 0 -4px #0000003d, 0 6px 12px #100c13;
      color: var(--medal);
    }
    .podium-step::before { content: ""; position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(105deg, transparent 45%, #ffffff1c 50%, transparent 56%); transform: translateX(-110%); }
    .place-1 .podium-step { box-shadow: inset 0 3px #ffffff2e, inset 0 -4px #00000050, 0 0 1.5rem #f0ad4254, 0 8px 14px #100c13; }
    .place-1 .podium-step::after { content: "CHAMPION"; position: absolute; left: 50%; bottom: .45rem; transform: translateX(-50%); color: #ffde98; font: 800 .55rem ui-monospace, monospace; letter-spacing: .16em; }
    .podium-step strong { font: 850 clamp(1.25rem, 4vw, 2rem)/1 ui-monospace, monospace; }
    .podium-step span { color: var(--medal); font-size: .72rem; font-weight: 650; }
    .place-1 .podium-step span { padding-bottom: .9rem; }
    .trophy { display: block; width: clamp(4.2rem, 15vw, 5.8rem); height: auto; margin: 0 auto .15rem; filter: drop-shadow(0 0 1rem #edaa4d88); }
    @media (prefers-reduced-motion: no-preference) {
      .trophy { animation: trophy-float 3s ease-in-out infinite; }
      .podium-step::before { animation: podium-shine 4.5s ease-in-out infinite; }
      @keyframes trophy-float { 50% { transform: translateY(-.3rem) rotate(2deg); } }
      @keyframes podium-shine { 0%, 62% { transform: translateX(-110%); } 85%, 100% { transform: translateX(110%); } }
    }
    #grid-view { margin-top: .65rem; }
    .view-controls { display: inline-flex; gap: .25rem; margin: .65rem 0; padding: .25rem; border: 1px solid var(--line); border-radius: .65rem; background: var(--surface); }
    .view-controls button, .week-step, .browse select {
      min-height: 2.75rem;
      border: 1px solid var(--line);
      border-radius: .45rem;
      background: var(--surface-raised);
      color: var(--ink);
      font: inherit;
    }
    .view-controls button, .week-step { padding: .45rem .75rem; cursor: pointer; }
    .view-controls button { border-color: transparent; background: transparent; font-weight: 700; }
    .view-controls button[aria-pressed="true"] { background: var(--accent); color: var(--canvas); }
    .browse { max-width: 34rem; margin-top: .35rem; }
    .browse label { display: block; margin-bottom: .25rem; color: var(--muted); font-size: .88rem; }
    .picker-row { display: flex; gap: .4rem; }
    .browse select { flex: 1; width: 100%; min-width: 0; padding: .4rem .65rem; }
    .week-step { min-width: 2.75rem; }
    .week-step:disabled { opacity: .42; cursor: default; }
    .browse-summary { margin: .8rem 0 .45rem; color: var(--muted); font-size: .88rem; overflow-wrap: anywhere; }
    .browse-results { display: grid; gap: .45rem; margin: 0; padding: 0; list-style: none; }
    .browse-results > li { padding: .65rem .8rem; border: 1px solid var(--line); border-radius: .55rem; background: var(--surface); overflow-wrap: anywhere; }
    .browse-results strong { display: block; margin-bottom: .15rem; font-size: .9rem; color: var(--accent); }
    .browse-results span { display: block; }
    .browse-results .player-video-button { display: block; width: fit-content; }
    .browse-results .empty-week { color: var(--muted); }
    .table-wrap { overflow: auto; border: 1px solid var(--line); border-radius: .8rem; background: var(--surface); }
    table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: .875rem; }
    th, td { padding: .65rem .75rem; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); text-align: left; vertical-align: middle; }
    tr > :last-child { border-right: 0; }
    tbody tr:last-child > * { border-bottom: 0; }
    thead th { background: var(--surface-raised); white-space: nowrap; }
    tr > :first-child { position: sticky; left: 0; z-index: 1; min-width: 13rem; background: var(--surface); }
    thead tr > :first-child { background: var(--surface-raised); }
    tbody th { overflow-wrap: anywhere; }
    .rank { margin-right: .4rem; color: var(--muted); font: 700 .74rem ui-monospace, monospace; }
    tbody .leader th { color: var(--accent); }
    td { min-width: 6.25rem; }
    .score, .total-heading { min-width: 0; text-align: center; font-variant-numeric: tabular-nums; }
    .score { color: var(--accent); font-weight: 800; }
    .no-donut { text-align: center; color: var(--muted); }
    .has-donut { background: #352638; }
    .has-donut ul { list-style: none; margin: 0; padding: 0; }
    .has-donut li + li { margin-top: .35rem; padding-top: .35rem; border-top: 1px solid var(--line); }
    .player-video-button { display: inline; margin: 0; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; text-align: left; text-decoration: underline; text-decoration-color: #9b6e94; text-underline-offset: .2rem; cursor: pointer; }
    .player-video-button:hover, .player-video-button:focus-visible { color: var(--accent); text-decoration-color: currentColor; }
    .video-overdue .team-name, .video-missing { color: var(--danger); }
    #videos { margin-top: 2.4rem; padding-top: 1.6rem; border-top: 1px solid var(--line); }
    .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .collection-link, .video-status {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.5rem;
      padding: .4rem .75rem;
      border: 1px solid var(--line);
      border-radius: .5rem;
      background: var(--surface-raised);
      color: var(--ink);
      font-weight: 750;
      text-decoration: none;
    }
    .video-metrics { display: flex; flex-wrap: wrap; gap: .65rem; margin: .9rem 0; }
    .video-metrics > div { display: flex; align-items: baseline; gap: .55rem; padding: .45rem .75rem; border: 1px solid var(--line); border-radius: .6rem; background: var(--surface); }
    .video-metrics strong { color: var(--accent); font-size: 1.2rem; }
    .video-metrics span { color: var(--muted); font-size: .85rem; }
    .video-missing-metric strong { color: var(--danger); }
    .video-log { display: grid; gap: .55rem; margin: 0; padding: 0; list-style: none; }
    .video-card { min-width: 0; border: 1px solid var(--line); border-radius: .7rem; background: var(--surface); overflow: hidden; }
    details.video-card > summary { display: grid; grid-template-columns: 5rem minmax(0, 1fr) auto; grid-template-rows: auto auto; gap: .1rem .8rem; align-items: center; padding: .75rem .85rem; cursor: pointer; list-style: none; }
    details.video-card > summary::-webkit-details-marker { display: none; }
    details.video-card > summary::before { content: "›"; grid-column: 1; grid-row: 1 / span 2; align-self: center; color: var(--accent); font-size: 1.45rem; transform-origin: center; transition: transform .16s ease; }
    details.video-card[open] > summary::before { transform: rotate(90deg); }
    details.video-card[open] > summary { border-bottom: 1px solid var(--line); background: var(--surface-raised); }
    .video-card strong, .video-team { min-width: 0; overflow-wrap: anywhere; }
    details.video-card strong { grid-column: 2; grid-row: 1; }
    .video-week { color: var(--muted); font: 700 .72rem ui-monospace, monospace; text-transform: uppercase; }
    details.video-card .video-week { grid-column: 1; grid-row: 1 / span 2; padding-left: 1.25rem; }
    .video-team { color: var(--muted); font-size: .82rem; }
    details.video-card .video-team { grid-column: 2; grid-row: 2; }
    .video-status { min-width: 4.75rem; min-height: 2.35rem; font-size: .82rem; }
    details.video-card .video-status { grid-column: 3; grid-row: 1 / span 2; }
    .video-missing-card { border-color: #843143; background: #2c1b24; }
    li.video-missing-card { display: grid; grid-template-columns: 5rem minmax(0, 1fr) auto; grid-template-rows: auto auto; gap: .1rem .8rem; align-items: center; padding: .75rem .85rem; }
    li.video-missing-card .video-week { grid-column: 1; grid-row: 1 / span 2; }
    li.video-missing-card strong { grid-column: 2; grid-row: 1; }
    li.video-missing-card .video-team { grid-column: 2; grid-row: 2; }
    li.video-missing-card .video-status { grid-column: 3; grid-row: 1 / span 2; }
    .video-missing-card strong, .video-status-missing { color: var(--danger); }
    .video-status-missing { border-color: #843143; background: #421f2b; }
    .video-special-card { border-style: dashed; }
    .video-card-body { display: flex; flex-direction: column; align-items: center; gap: .8rem; padding: .85rem; }
    .donut-video { display: block; width: min(100%, 52rem); max-height: 34rem; margin-inline: auto; border: 1px solid var(--line); border-radius: .55rem; background: #08070a; }
    .video-gallery { margin-top: 1rem; border: 1px solid var(--line); border-radius: .75rem; background: var(--surface); }
    .video-gallery summary { padding: .8rem .9rem; color: var(--accent); font-weight: 800; cursor: pointer; }
    .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: .65rem; margin: 0; padding: 0 .8rem .8rem; list-style: none; }
    .gallery-grid li { display: grid; gap: .45rem; min-width: 0; padding: .65rem; border: 1px solid var(--line); border-radius: .6rem; background: var(--surface-raised); }
    .gallery-grid strong { overflow-wrap: anywhere; }
    .gallery-grid video { width: 100%; max-height: 24rem; border-radius: .45rem; background: #08070a; }
    .rating-highlights { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; margin: .9rem 0; }
    .rating-highlight { display: grid; gap: .1rem; min-width: 0; padding: .8rem .9rem; border: 1px solid var(--line); border-radius: .7rem; background: var(--surface); }
    .rating-highlight span:first-child { color: var(--muted); font: 750 .7rem ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
    .rating-highlight strong { overflow-wrap: anywhere; }
    .rating-highlight span:last-child { color: var(--accent); font-weight: 800; }
    .rating-best { border-color: #82612f; background: #2a211d; }
    .rating-best span:last-child { color: #f6c866; }
    .rating-worst { border-color: #713143; background: #281c24; }
    .rating-worst span:last-child { color: var(--danger); }
    .star-rating { display: grid; width: min(100%, 52rem); gap: .85rem; padding: .9rem; border: 1px solid var(--line); border-radius: .6rem; background: var(--surface-raised); text-align: center; }
    .your-rating, .league-rating { display: grid; justify-items: center; gap: .35rem; }
    .league-rating { padding-top: .8rem; border-top: 1px solid var(--line); }
    .your-rating > span:first-child, .league-rating > span:first-child { color: var(--muted); font: 750 .68rem ui-monospace, monospace; letter-spacing: .07em; text-transform: uppercase; }
    .star-control { position: relative; display: inline-block; flex: 0 0 auto; color: #64546a; font-size: 1.35rem; line-height: 1; letter-spacing: .03em; white-space: nowrap; }
    .star-fill { position: absolute; inset: 0 auto 0 0; width: 0; overflow: hidden; color: #f6c866; white-space: nowrap; pointer-events: none; }
    .star-rating input { position: absolute; inset: -.35rem 0; width: 100%; height: calc(100% + .7rem); margin: 0; opacity: 0; cursor: pointer; }
    .star-control:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: .2rem; border-radius: .2rem; }
    .star-rating output, .league-rating small { color: var(--muted); font: 700 .75rem ui-monospace, monospace; white-space: nowrap; }
    .league-rating strong { color: var(--accent); font-size: 1.15rem; }
    .rating-error { margin: 0; color: var(--danger); font-size: .78rem; }
    @media (max-width: 36rem) {
      .wrap { width: calc(100% - 1rem); }
      .brand { padding-block: .75rem; }
      .hero { align-items: flex-start; gap: .5rem; padding-block: 1.35rem 1.55rem; }
      .hero h1 { font-size: clamp(2.35rem, 15vw, 3.5rem); }
      .donut { width: 4.4rem; margin: .25rem 0 0; }
      main { padding-top: 1rem; }
      .metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .45rem; margin-bottom: 1rem; }
      .metrics > div { display: grid; gap: 0; padding: .55rem .65rem; }
      .podium { margin-bottom: 1.25rem; padding-inline: .4rem; }
      .podium-steps { padding-top: .65rem; }
      .view-controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; }
      .view-controls button { padding-inline: .3rem; font-size: .86rem; }
      .browse { width: 100%; max-width: none; }
      th, td { padding: .55rem .55rem; }
      tr > :first-child { min-width: 9.25rem; max-width: 9.25rem; }
      .section-heading { align-items: flex-start; }
      .collection-link { flex: 0 0 auto; }
      .access-card form { grid-template-columns: 1fr; }
      .rating-highlights { grid-template-columns: 1fr; }
      details.video-card > summary, li.video-missing-card { grid-template-columns: 4.25rem minmax(0, 1fr); }
      details.video-card .video-status, li.video-missing-card .video-status { grid-column: 2; grid-row: 3; justify-self: start; min-height: 2rem; }
      .video-card-body { padding: .6rem; }
      .star-rating { padding: .75rem .6rem; }
      .video-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .video-metrics > div { justify-content: center; }
      .gallery-grid { grid-template-columns: 1fr; padding-inline: .55rem; }
    }
  </style>
</head>
<body>
  <div class="access-gate" id="access-gate">
    <div class="access-card">
      <svg class="access-donut" viewBox="0 0 160 160" aria-hidden="true">
        <circle cx="80" cy="80" r="51" fill="none" stroke="#d58d54" stroke-width="42"/>
        <circle cx="80" cy="75" r="49" fill="none" stroke="#ffadbc" stroke-width="36"/>
        <path d="M43 42l9 4m24-20 4 10m28 0-6 8m26 9 8-3m-7 33 10 4m-20 25 7 6m-37 0 2 10m-29-13-8 5m-15-23-9-2m3-24-10-4" stroke="#752646" stroke-width="3.5" stroke-linecap="round"/>
      </svg>
      <p class="access-brand">CTESPN Dynasty</p>
      <h1>Mirror, mirror on the wall, who has the most CTE of them all?</h1>
      <form id="access-form">
        <div class="password-field">
          <input id="access-password" type="password" autocomplete="current-password" aria-label="Answer" placeholder="Answer" required>
          <button class="show-password" id="show-password" type="button" aria-pressed="false">Show</button>
        </div>
        <button class="access-submit" type="submit">Enter</button>
      </form>
      <p class="access-error" id="access-error" role="alert" aria-live="polite"></p>
    </div>
  </div>
  <header>
    <div class="wrap">
      <p class="brand">CTESPN Dynasty</p>
      <div class="hero">
        <div>
          <p class="kicker">$season season · $coverage</p>
          <h1>Donut Tracker</h1>
        </div>
        <svg class="donut" viewBox="0 0 160 160" aria-hidden="true">
          <circle cx="80" cy="80" r="51" fill="none" stroke="#d58d54" stroke-width="42"/>
          <circle cx="80" cy="75" r="49" fill="none" stroke="#ffadbc" stroke-width="36"/>
          <path d="M43 42l9 4m24-20 4 10m28 0-6 8m26 9 8-3m-7 33 10 4m-20 25 7 6m-37 0 2 10m-29-13-8 5m-15-23-9-2m3-24-10-4" stroke="#752646" stroke-width="3.5" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </header>
  <main class="wrap">
    <section class="metrics" aria-label="Season totals">
      <div><strong>$total</strong><span>Donuts</span></div>
      <div><strong>$teams</strong><span>Fantasy teams</span></div>
    </section>
    <section class="podium" aria-labelledby="podium-title"$podium_hidden>
      <h2 id="podium-title">Top 3</h2>
      <div class="podium-steps">$podium</div>
    </section>
    <section id="leaderboard" aria-labelledby="leaderboard-title">
      <h2 id="leaderboard-title" tabindex="-1">Weekly leaderboard</h2>
      <div class="view-controls" id="view-controls" role="group" aria-label="Leaderboard view" hidden>
        <button type="button" data-view="week" aria-pressed="false">By week</button>
        <button type="button" data-view="team" aria-pressed="false">By team</button>
        <button type="button" data-view="grid" aria-pressed="true">Full grid</button>
      </div>
      <div class="browse" id="browse" hidden>
        <div id="week-picker">
          <label for="browse-week">Week</label>
          <div class="picker-row">
            <button type="button" class="week-step" id="previous-week" aria-label="Previous week">‹</button>
            <select id="browse-week"></select>
            <button type="button" class="week-step" id="next-week" aria-label="Next week">›</button>
          </div>
        </div>
        <div id="team-picker" hidden>
          <label for="browse-team">Fantasy team</label>
          <select id="browse-team"></select>
        </div>
        <p id="browse-summary" class="browse-summary" role="status"></p>
        <ul id="browse-results" class="browse-results" role="list"></ul>
      </div>
      <div id="grid-view">
        <div class="table-wrap" id="weekly-log" tabindex="0" role="region" aria-labelledby="leaderboard-title">
          <table aria-label="Donuts by fantasy team and week">
            <thead><tr><th scope="col">Fantasy team</th><th scope="col" class="total-heading">Total</th>$week_headers</tr></thead>
            <tbody>$leaderboard</tbody>
          </table>
        </div>
      </div>
    </section>
    <section id="videos" aria-labelledby="videos-title">
      <div class="section-heading">
        <h2 id="videos-title">Video log</h2>
        $video_collection
      </div>
      <div class="rating-highlights" aria-label="Video rating leaders">
        <article class="rating-highlight rating-best">
          <span>Best rated</span>
          <strong id="best-rated-player">Not rated</strong>
          <span id="best-rated-score">—</span>
        </article>
        <article class="rating-highlight rating-worst">
          <span>Worst rated</span>
          <strong id="worst-rated-player">Not rated</strong>
          <span id="worst-rated-score">—</span>
        </article>
      </div>
      <div class="video-metrics">$video_metrics</div>
      <ul class="video-log">$video_log</ul>
      <details class="video-gallery" id="video-gallery">
        <summary>All 18 videos</summary>
        <ul class="gallery-grid">$video_gallery</ul>
      </details>
    </section>
  </main>
  <script>
    (() => {
      const expected = "dab1a5c928f2edaa4d5247609fedf73a995072ce4aaeed7ab34d350f0d2ced31";
      const form = document.querySelector("#access-form");
      const password = document.querySelector("#access-password");
      const showPassword = document.querySelector("#show-password");
      const error = document.querySelector("#access-error");
      const toHex = bytes => Array.from(bytes, byte => byte.toString(16).padStart(2, "0")).join("");
      showPassword.addEventListener("click", () => {
        const showing = password.type === "text";
        password.type = showing ? "password" : "text";
        showPassword.textContent = showing ? "Show" : "Hide";
        showPassword.setAttribute("aria-pressed", String(!showing));
        password.focus();
      });
      form.addEventListener("submit", async event => {
        event.preventDefault();
        const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(password.value));
        if (toHex(new Uint8Array(digest)) === expected) {
          try { sessionStorage.setItem("ctespn-access", "granted"); } catch (storageError) {}
          document.documentElement.classList.add("access-granted");
          password.value = "";
          error.textContent = "";
          document.querySelector("#leaderboard-title").focus({ preventScroll: true });
        } else {
          error.textContent = "Wrong password";
          password.select();
        }
      });
    })();
    (() => {
      const table = document.querySelector("#weekly-log table");
      const weeks = Array.from(table.tHead.rows[0].cells).slice(2).map(cell => cell.textContent);
      const teams = Array.from(table.tBodies[0].rows).map(row => ({
        name: row.querySelector(".team-name").textContent,
        total: Number(row.cells[1].textContent),
        weeks: Array.from(row.cells).slice(2).map(cell =>
          Array.from(cell.querySelectorAll("li"), player => ({
            name: player.dataset.player || player.textContent,
            missing: player.classList.contains("video-missing"),
            target: player.querySelector("[data-video-target]")?.dataset.videoTarget || "",
          }))
        ),
      }));
      if (!weeks.length || !teams.length) return;

      const controls = document.querySelector("#view-controls");
      const buttons = Array.from(controls.querySelectorAll("button"));
      const grid = document.querySelector("#grid-view");
      const browse = document.querySelector("#browse");
      const weekPicker = document.querySelector("#week-picker");
      const teamPicker = document.querySelector("#team-picker");
      const weekSelect = document.querySelector("#browse-week");
      const teamSelect = document.querySelector("#browse-team");
      const previous = document.querySelector("#previous-week");
      const next = document.querySelector("#next-week");
      const summary = document.querySelector("#browse-summary");
      const results = document.querySelector("#browse-results");
      const narrowScreen = window.matchMedia("(max-width: 45rem)");
      let mode = narrowScreen.matches ? "week" : "grid";
      let pickedView = false;

      weeks.forEach(week => weekSelect.add(new Option(week)));
      teams.forEach(team => teamSelect.add(new Option(team.name)));
      weekSelect.selectedIndex = weeks.length - 1;

      function countLabel(count) {
        return count + (count === 1 ? " donut" : " donuts");
      }

      function showResults(cards, title) {
        summary.textContent = title;
        results.replaceChildren(...cards.map(({ heading, players, missing }) => {
          const card = document.createElement("li");
          const label = document.createElement("strong");
          label.textContent = heading;
          if (missing) label.className = "video-missing";
          card.append(label);
          for (const player of players.length ? players : [{ name: "No donuts", missing: false }]) {
            const name = player.target && !player.missing
              ? document.createElement("button")
              : document.createElement("span");
            name.textContent = player.name;
            if (player.target && !player.missing) {
              name.type = "button";
              name.className = "player-video-button";
              name.dataset.videoTarget = player.target;
              name.setAttribute("aria-label", "Open the video for " + player.name);
            }
            if (player.missing) name.className = "video-missing";
            if (!players.length) name.className = "empty-week";
            card.append(name);
          }
          return card;
        }));
      }

      function render() {
        grid.hidden = mode !== "grid";
        browse.hidden = mode === "grid";
        weekPicker.hidden = mode !== "week";
        teamPicker.hidden = mode !== "team";
        for (const button of buttons) {
          button.setAttribute("aria-pressed", String(button.dataset.view === mode));
        }
        if (mode === "week") {
          const week = weekSelect.selectedIndex;
          previous.disabled = week === 0;
          next.disabled = week === weeks.length - 1;
          const cards = teams
            .filter(team => team.weeks[week].length)
            .map(team => ({
              heading: team.name,
              players: team.weeks[week],
              missing: team.weeks[week].some(player => player.missing),
            }));
          const count = cards.reduce((total, card) => total + card.players.length, 0);
          showResults(cards, weeks[week] + " · " + countLabel(count));
        } else if (mode === "team") {
          const team = teams[teamSelect.selectedIndex];
          const cards = weeks
            .map((week, index) => ({
              heading: week,
              players: team.weeks[index],
              missing: team.weeks[index].some(player => player.missing),
            }))
            .reverse();
          showResults(cards, team.name + " · " + countLabel(team.total));
        }
      }

      for (const button of buttons) {
        button.addEventListener("click", () => {
          pickedView = true;
          mode = button.dataset.view;
          render();
        });
      }
      weekSelect.addEventListener("change", render);
      teamSelect.addEventListener("change", render);
      previous.addEventListener("click", () => {
        weekSelect.selectedIndex -= 1;
        render();
        if (previous.disabled) weekSelect.focus();
      });
      next.addEventListener("click", () => {
        weekSelect.selectedIndex += 1;
        render();
        if (next.disabled) weekSelect.focus();
      });
      narrowScreen.addEventListener("change", event => {
        if (pickedView) return;
        mode = event.matches ? "week" : "grid";
        render();
      });
      render();
      controls.hidden = false;
    })();
    (() => {
      const endpoint = "https://ctespn-donut-ratings-api.thrivingaria1.chatgpt.site/ratings";
      const voterStorageKey = "ctespn-rating-voter-v1";
      const controls = Array.from(document.querySelectorAll(".star-rating"));
      const bestPlayer = document.querySelector("#best-rated-player");
      const bestScore = document.querySelector("#best-rated-score");
      const worstPlayer = document.querySelector("#worst-rated-player");
      const worstScore = document.querySelector("#worst-rated-score");
      let voterId = "";
      try { voterId = localStorage.getItem(voterStorageKey) || ""; } catch (error) {}
      if (!voterId) {
        voterId = crypto.randomUUID();
        try { localStorage.setItem(voterStorageKey, voterId); } catch (error) {}
      }

      function setYourVisual(control, rated = control.dataset.rated === "true") {
        const input = control.querySelector("input");
        const value = Number(input.value);
        control.querySelector(".star-fill").style.width = (value * 20) + "%";
        control.querySelector("output").value = rated
          ? value.toFixed(1) + " ★"
          : "Not rated";
      }

      function leagueRatings() {
        return controls
          .filter(control => Number(control.dataset.voteCount || 0) > 0)
          .map(control => ({
            player: control.dataset.player,
            team: control.dataset.team,
            value: Number(control.dataset.leagueAverage),
            count: Number(control.dataset.voteCount),
          }));
      }

      function setLeader(playerNode, scoreNode, ratings, value) {
        const tied = ratings.filter(rating => rating.value === value);
        playerNode.textContent = tied.map(rating => rating.player).join(" · ");
        const votes = tied.reduce((total, rating) => total + rating.count, 0);
        scoreNode.textContent = value.toFixed(2) + " ★ · " + votes + " " + (votes === 1 ? "vote" : "votes");
      }

      function updateLeaders() {
        const ratings = leagueRatings();
        if (!ratings.length) {
          bestPlayer.textContent = worstPlayer.textContent = "Not rated";
          bestScore.textContent = worstScore.textContent = "—";
          return;
        }
        const values = ratings.map(rating => rating.value);
        setLeader(bestPlayer, bestScore, ratings, Math.max(...values));
        setLeader(worstPlayer, worstScore, ratings, Math.min(...values));
      }

      function applyRating(control, rating) {
        const yourRating = rating?.yourRating;
        const average = rating?.average;
        const count = Number(rating?.count || 0);
        const input = control.querySelector("input");
        if (yourRating !== null && yourRating !== undefined) {
          input.value = yourRating;
          control.dataset.rated = "true";
        } else {
          input.value = 0;
          control.dataset.rated = "false";
        }
        control.dataset.leagueAverage = count ? Number(average) : "";
        control.dataset.voteCount = count;
        control.querySelector("[data-league-average]").textContent =
          count ? Number(average).toFixed(2) + " ★" : "Not rated";
        control.querySelector("[data-vote-count]").textContent =
          count + " " + (count === 1 ? "vote" : "votes");
        setYourVisual(control);
      }

      function showError(control, message) {
        const error = control.querySelector(".rating-error");
        error.textContent = message;
        error.hidden = !message;
      }

      async function loadRatings() {
        const response = await fetch(endpoint + "?voter=" + encodeURIComponent(voterId), {
          headers: { "accept": "application/json" },
        });
        if (!response.ok) throw new Error("Ratings are unavailable.");
        const payload = await response.json();
        for (const control of controls) {
          applyRating(control, payload.ratings?.[control.dataset.ratingKey]);
        }
        updateLeaders();
      }

      async function saveRating(control) {
        const input = control.querySelector("input");
        input.disabled = true;
        showError(control, "");
        try {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              videoKey: control.dataset.ratingKey,
              voterId,
              rating: Number(input.value),
            }),
          });
          if (!response.ok) throw new Error("Could not save your rating.");
          const saved = await response.json();
          applyRating(control, saved);
          updateLeaders();
        } catch (error) {
          showError(control, "Could not save. Try again.");
        } finally {
          input.disabled = false;
        }
      }

      for (const control of controls) {
        const input = control.querySelector("input");
        setYourVisual(control, false);
        input.addEventListener("input", () => {
          setYourVisual(control, true);
        });
        input.addEventListener("change", () => saveRating(control));
      }

      loadRatings().catch(() => {
        for (const control of controls) showError(control, "Ratings are temporarily unavailable.");
      });

      document.addEventListener("click", event => {
        const button = event.target.closest(".player-video-button");
        if (!button) return;
        const card = document.getElementById(button.dataset.videoTarget);
        if (!card) return;
        card.open = true;
        card.scrollIntoView({ behavior: "smooth", block: "center" });
        card.querySelector("summary")?.focus({ preventScroll: true });
      });
    })();
  </script>
</body>
</html>
